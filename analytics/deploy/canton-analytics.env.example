# Settings for the canton-analytics daemon. Every flag of `canton-analytics
# run` also reads its environment variable; these are the usual ones.

# The SurrealDB the Canton syncer writes, and a read-only (VIEWER) user.
SURREAL_URL=ws://127.0.0.1:8000
SURREAL_NAMESPACE=canton
SURREAL_DATABASE=event_graph
SURREAL_USER=analytics
SURREAL_PASSWORD=change-me

# Where the tables go: a folder for testing…
CANTON_ANALYTICS_TABLES=/var/lib/canton-analytics/tables
# …or object storage in production, with that cloud's usual credentials:
# CANTON_ANALYTICS_TABLES=s3://my-bucket/canton-analytics
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=…
# AWS_SECRET_ACCESS_KEY=…
# CANTON_ANALYTICS_TABLES=az://my-container/canton-analytics
# AZURE_STORAGE_ACCOUNT_NAME=…
# AZURE_STORAGE_ACCOUNT_KEY=…
# CANTON_ANALYTICS_TABLES=gs://my-bucket/canton-analytics
# GOOGLE_APPLICATION_CREDENTIALS=/etc/canton-analytics/gcs.json

RUST_LOG=info
